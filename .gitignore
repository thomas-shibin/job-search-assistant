__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Secrets and personal config
.env
config/config.yaml

# Local database
data/*.db
data/*.db-journal

# Generated/personal artifacts (never commit resumes or application output)
data/resumes/*
!data/resumes/.gitkeep
data/applications/**
!data/applications/.gitkeep

# Server logs
data/logs/

# Files dropped into the project root (downloaded resumes etc.) and packages
/*.docx
/*.pdf
/*.zip
/tmp/

# Database files of any kind (WAL/SHM journals, backups) and saved emails:
# they hold users' personal data and must never be committed.
data/*.db-wal
data/*.db-shm
data/backups/
data/mail_outbox/

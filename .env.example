# Copy this file to .env and fill in real values. Never commit .env.

# Required for AI-powered requirement extraction and resume tailoring.
OPENAI_API_KEY=sk-your-key-here

# SQLite by default. Swappable for a PostgreSQL URL later without code changes.
DATABASE_URL=sqlite:///./data/job_assistant.db

# Required only if any search_profile in config.yaml sets adzuna_enabled: true.
# Free signup at https://developer.adzuna.com/.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

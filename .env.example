# Secrets and machine settings. Copy to .env (the installers do this for you)
# and fill in what you have -- every key is optional; the matching features stay
# off until it's set. Never share or commit .env.

# AI analysis and resume tailoring. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Job search (free). https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# A second job board, asked only when Adzuna can't answer (its limit is used up,
# or it's down). Request a free partner key at https://jooble.org/api/about.
JOOBLE_API_KEY=

# Backups: every night at BACKUP_HOUR (server time) the database and members'
# files are saved in data/backups (7 daily, 4 weekly, 6 monthly kept). With a key
# and a bucket they're also encrypted and copied off the server -- see
# docs/BACKUPS.md. Make a key with: python cli.py backup-key  (keep a copy in a
# password manager: without it the off-server copies can't be opened).
BACKUP_ENCRYPTION_KEY=
BACKUP_HOUR=3
# Any S3-compatible bucket, e.g. Cloudflare R2: https://<account id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto

# Telegram alerts: create a bot with @BotFather and paste its token here. Each
# member connects their own chat from the Watchlist page ("Connect Telegram").
TELEGRAM_BOT_TOKEN=

# Docker only: the address and port the app answers plain http on (for your own
# network), and the user that owns data/ on Linux (`id -u` / `id -g`).
APP_BIND=127.0.0.1
APP_PORT=8000
APP_UID=1000
APP_GID=1000
# Docker only: keep the data (database, resumes, backups) and settings outside
# this folder, so copying in a new version can never replace them. Empty means
# ./data and ./config here. `sudo ./scripts/move-data.sh` moves them to
# /srv/hirlumo and fills these in (with APP_UID/APP_GID=1990, its own user).
HIRLUMO_DATA_DIR=
HIRLUMO_CONFIG_DIR=
# Theme for visitors who haven't picked one with the sun/moon button:
# light, dark, or system (follow their device's light/dark setting).
DEFAULT_THEME=system
# Your time zone (the installer sets it), e.g. America/Vancouver, America/Toronto.
TZ=
# Docker only: run a published image (e.g. thomasshibin90/hirlumo:0.8) instead
# of building from source. Empty = build from this folder.
APP_IMAGE=
# Docker only -- serving the public site over https, one of:
# a) Cloudflare Tunnel (no open ports): `docker compose --profile tunnel up -d`
#    with the tunnel's token (Cloudflare Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=
# b) Built-in Caddy proxy (ports 80/443 open, DNS records "DNS only" in
#    Cloudflare): `docker compose --profile https up -d`.
DOMAIN=hirlumo.com
# Either way www.<domain> forwards to PUBLIC_URL's address.
# Behind a different proxy (nginx, Cloudflare Tunnel...), set its address here so
# visitors' real IP addresses are used for sign-in rate limits.
# FORWARDED_ALLOW_IPS=

# Optional: PostgreSQL instead of the built-in SQLite file, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/jobs

# ---- Accounts and sign-in ----
# Where people reach the app -- used in email links and as the Google/Facebook
# redirect address (register <PUBLIC_URL>/auth/google/callback,
# <PUBLIC_URL>/auth/facebook/callback and <PUBLIC_URL>/auth/linkedin/callback with them). Use https in production:
# PUBLIC_URL=https://hirlumo.com
PUBLIC_URL=http://127.0.0.1:8000
# Comma-separated emails that become Super Admins when they sign up or confirm
# their email (the trusted bootstrap; `python cli.py grant-role` also works).
ADMIN_EMAILS=
# Cookies only over HTTPS. Defaults to on when PUBLIC_URL starts with https://.
# COOKIE_SECURE=true

# "Continue with Google": https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Facebook": https://developers.facebook.com/apps (Facebook Login)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# "Continue with LinkedIn": https://www.linkedin.com/developers/apps -> Create app,
# then Products -> "Sign In with LinkedIn using OpenID Connect", and under Auth
# add the redirect URL <PUBLIC_URL>/auth/linkedin/callback. (It shares name,
# email and country only; members import their jobs from the Profile page.)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Outgoing email: sign-up / sign-in codes, password reset, welcome. REQUIRED
# before real users can sign up. Any SMTP service works (e.g. Amazon SES,
# Resend, Postmark, SendGrid, Mailgun). Without it (local development), each
# email is saved as a file under MAIL_OUTBOX_DIR instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hirlumo <no-reply@hirlumo.com>
SMTP_STARTTLS=true
MAIL_OUTBOX_DIR=data/mail_outbox
# Your mailing address (street or PO box), printed at the foot of job alert
# emails. Canada's anti-spam law (CASL) requires it in messages like these.
MAIL_POSTAL_ADDRESS=

# Signs the six-digit email codes (HMAC). Set a long random value in
# production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# If unset, a random key is made at start-up (codes then stop working across a
# restart -- harmless, they only last 60 seconds -- but every server process
# must share one key if you ever run several).
APP_SECRET_KEY=

# Search engines: prove you own the site (Google Search Console / Bing Webmaster
# Tools -> "HTML tag" method; paste only the content="..." value). Optional if
# you verify by a DNS TXT record on Cloudflare instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

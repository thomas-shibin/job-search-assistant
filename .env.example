# Secrets and machine settings. Copy to .env (the installers do this for you)
# and fill in what you have -- every key is optional; the matching features stay
# off until it's set. Never share or commit .env.

# AI analysis and resume tailoring. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Job search (free). https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Telegram alerts: create a bot with @BotFather and paste its token here. Each
# member connects their own chat from the Watchlist page ("Connect Telegram").
TELEGRAM_BOT_TOKEN=

# Docker only: the port the dashboard listens on (http://127.0.0.1:APP_PORT),
# and the user that owns data/ on Linux (`id -u` / `id -g`).
APP_PORT=8000
APP_UID=1000
APP_GID=1000
# Your time zone (the installer sets it), e.g. America/Vancouver, America/Toronto.
TZ=
# Docker only: run a published image instead of building from source.
# Empty = build from this folder.
APP_IMAGE=

# Optional: PostgreSQL instead of the built-in SQLite file, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/jobs

# ---- Accounts and sign-in ----
# Where people reach the app -- used in email links and as the Google/Facebook
# redirect address (register <PUBLIC_URL>/auth/google/callback and
# <PUBLIC_URL>/auth/facebook/callback with them). Use https in production.
PUBLIC_URL=http://127.0.0.1:8000
# Comma-separated emails that become Super Admins when they sign up or confirm
# their email (the trusted bootstrap; `python cli.py grant-role` also works).
ADMIN_EMAILS=
# Cookies only over HTTPS. Defaults to on when PUBLIC_URL starts with https://.
# COOKIE_SECURE=true

# "Continue with Google": https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Continue with Facebook": https://developers.facebook.com/apps (Facebook Login)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Outgoing email: sign-up / sign-in codes, password reset, welcome. REQUIRED
# before real users can sign up. Any SMTP service works (e.g. Amazon SES,
# Resend, Postmark, SendGrid, Mailgun). Without it (local development), each
# email is saved as a file under MAIL_OUTBOX_DIR instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Job Search Assistant <no-reply@example.com>
SMTP_STARTTLS=true
MAIL_OUTBOX_DIR=data/mail_outbox

# Signs the six-digit email codes (HMAC). Set a long random value in
# production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# If unset, a random key is made at start-up (codes then stop working across a
# restart -- harmless, they only last 60 seconds -- but every server process
# must share one key if you ever run several).
APP_SECRET_KEY=
